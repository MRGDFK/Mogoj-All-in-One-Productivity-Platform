{
  "name": "mogoj",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @mogoj/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @mogoj/api exec prisma generate",
    "db:seed": "pnpm --filter @mogoj/api exec prisma db seed",
    "db:studio": "pnpm --filter @mogoj/api exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "prettier": "^3.4.0"
  }
}
