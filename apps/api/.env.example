# Postgres connection string (docker-compose defaults shown)
DATABASE_URL="postgresql://mogoj:mogoj@localhost:5433/mogoj?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Direct (non-pooled) connection used by prisma migrate; same as DATABASE_URL locally
DIRECT_URL="postgresql://mogoj:mogoj@localhost:5433/mogoj?schema=public"

# Frontend origin allowed to make credentialed requests (CORS)
WEB_ORIGIN="http://localhost:3000"

# JWT secrets — generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# CSRF double-submit cookie secret
CSRF_SECRET="change-me-csrf-secret-min-32-chars"

# Set to "false" to disable POST /auth/register (default: true in dev, false in production)
ALLOW_REGISTRATION=true

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="mogoj-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
